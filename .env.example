# Frontend (safe to expose: URL + publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: shown on the Privacy / Terms pages as the operator's contact address
VITE_CONTACT_EMAIL=

# Server-only secrets live in Supabase Edge Function secrets, NOT in this file:
#   supabase secrets set YOUTUBE_API_KEY=...
#   supabase secrets set ALLOWED_ORIGINS=https://your-domain.example   (optional CORS allowlist; default is *)
#   (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase)
